{
  "manifest_version": 3,
  "name": "CourseFinder - Smart Course Status Detector",
  "version": "1.0.0",
  "author": "Areeb",
  "description": "Smart detector for long-duration courses (20+ & 30+ hrs), project status, and personal completion tracker.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CourseFinder Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://localhost:3000/*",
    "*://*.coursera.org/*",
    "*://*.edx.org/*",
    "*://*.udemy.com/*",
    "file://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.coursera.org/*",
        "*://*.edx.org/*",
        "*://*.udemy.com/*",
        "http://localhost:3000/*",
        "http://localhost:5000/*",
        "file://*/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
